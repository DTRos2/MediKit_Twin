#!/bin/sh
# MediKit_Twin pre-commit hook
# - main/develop 직접 커밋 차단
# - feature/이니셜-기능 브랜치 이름 검사
# - .meta 누락/잔존 검사
# - 씬 파일 변경 경고

RED='\033[0;31m'; YELLOW='\033[0;33m'; NC='\033[0m'

branch=$(git symbolic-ref --short HEAD 2>/dev/null)

# 1. 보호 브랜치 직접 커밋 차단
case "$branch" in
  main|develop)
    printf "${RED}[커밋 차단]${NC} '%s' 브랜치에는 직접 커밋할 수 없습니다.\n" "$branch"
    echo "  → git checkout -b feature/<이니셜>-<기능> 으로 브랜치를 만들어 작업하세요."
    exit 1
    ;;
esac

# 2. 브랜치 이름 규칙
if [ -n "$branch" ] && ! echo "$branch" | grep -Eq '^feature/[a-z0-9]+-[a-z0-9-]+$'; then
  printf "${RED}[커밋 차단]${NC} 브랜치 이름이 규칙에 맞지 않습니다: %s\n" "$branch"
  echo "  → 형식: feature/<이니셜>-<기능>  (영문 소문자·숫자·하이픈)"
  echo "  → 예: feature/<이니셜>-conveyor"
  echo "  → 이름 변경: git branch -m feature/<이니셜>-<기능>"
  exit 1
fi

# 3. .meta 검사 (Assets/ 하위)
missing_meta=$(git -c core.quotepath=false diff --cached --name-only --diff-filter=A -- Assets |
  while IFS= read -r f; do
    case "$f" in *.meta) continue ;; esac
    git ls-files --error-unmatch -- "$f.meta" >/dev/null 2>&1 || echo "  $f"
  done)

stale_meta=$(git -c core.quotepath=false diff --cached --name-only --diff-filter=D -- Assets |
  while IFS= read -r f; do
    case "$f" in *.meta) continue ;; esac
    git ls-files --error-unmatch -- "$f.meta" >/dev/null 2>&1 && echo "  $f.meta"
  done)

if [ -n "$missing_meta" ]; then
  printf "${RED}[커밋 차단]${NC} .meta 파일 없이 추가된 에셋이 있습니다:\n%s\n" "$missing_meta"
  echo "  → Unity 에디터를 한 번 열어 .meta를 생성한 뒤 함께 git add 하세요."
  exit 1
fi

if [ -n "$stale_meta" ]; then
  printf "${RED}[커밋 차단]${NC} 에셋은 삭제됐는데 .meta가 남아 있습니다:\n%s\n" "$stale_meta"
  echo "  → 에셋은 Unity Project 창에서 삭제하고, .meta 삭제도 함께 git add 하세요."
  exit 1
fi

# 4. 씬 파일 경고 (차단하지 않음)
scenes=$(git -c core.quotepath=false diff --cached --name-only -- '*.unity')
if [ -n "$scenes" ]; then
  printf "${YELLOW}[알림]${NC} 씬 파일 변경이 포함되어 있습니다:\n"
  echo "$scenes" | sed 's/^/  /'
  echo "  → 팀 채널에 공유했나요? 가능하면 씬 변경은 단독 커밋으로 분리하세요."
fi

exit 0
