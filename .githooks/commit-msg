#!/bin/sh
# MediKit_Twin commit-msg hook — "<타입>: <제목>" 형식 검사

RED='\033[0;31m'; NC='\033[0m'

subject=$(head -n1 "$1")

# 자동 생성 메시지는 통과
case "$subject" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

types='feat|fix|chore|build|refactor|docs|style|train'

if ! echo "$subject" | grep -Eq "^($types)(\([a-z0-9_-]+\))?: [^ ].*$"; then
  printf "${RED}[커밋 차단]${NC} 커밋 메시지 형식이 올바르지 않습니다.\n"
  echo "  입력: $subject"
  echo ""
  echo "  형식: <타입>: <제목>   (콜론 뒤 한 칸 공백)"
  echo "  타입: feat | fix | chore | build | refactor | docs | style | train"
  echo "  예시: feat: 플레이어 대시 기능 추가"
  echo "        fix(dialogue): 대화창 중복 열림 수정"
  echo ""
  echo "  자세한 규칙은 COMMIT_RULES.md 참고"
  exit 1
fi

if echo "$subject" | grep -q '\.$'; then
  printf "${RED}[커밋 차단]${NC} 제목 끝에 마침표(.)를 붙이지 않습니다.\n"
  echo "  입력: $subject"
  exit 1
fi

exit 0
