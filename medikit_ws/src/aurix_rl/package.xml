<?xml version="1.0"?>
<package format="3">
  <name>aurix_rl</name>
  <version>0.1.0</version>
  <description>Reinforcement learning policy node and MoveIt goal node for the Unity robot arms (FR5, UR3)</description>
  <maintainer email="ajtwlscldjs@gmail.com">coc</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <!-- moveit_goal_node 전용. 없으면 CMake가 이 노드만 건너뛴다. -->
  <depend>moveit_ros_planning_interface</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
